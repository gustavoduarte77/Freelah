# Copie este arquivo para apps/api/.env (API) e apps/mobile/.env (app).
# NUNCA coloque valores reais neste arquivo: ele é versionado.

# ============================================================
# API  ->  apps/api/.env
# ============================================================
NODE_ENV=development
PORT=3333

# Origens autorizadas a chamar a API (separadas por vírgula).
# Web do Expo em desenvolvimento: http://localhost:8081
CORS_ORIGINS=http://localhost:8081

# --- Etapa 1: banco de dados (o código é o mesmo; só a URL muda) ---
# apps/api/.env = banco LOCAL (padrão, funciona offline). O Neon fica em apps/api/.env.neon.
#
# (a) PostgreSQL local, iniciado por "npm run db:local -w @freelah/api" (demonstração offline):
# DATABASE_URL=postgresql://freelah:freelah@127.0.0.1:54329/freelah_local?sslmode=disable
#
# (b) Neon, branch "production", em apps/api/.env.neon (NÃO em .env): conexão DIRETA (sem "-pooler").
# Formato: postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=
#
# Testes de integração (apps/api/.env.test): os testes APAGAM os dados desse banco.
# Padrão: banco local de testes. Para usar o branch "test" do Neon, troque a URL e adicione
# ALLOW_REMOTE_TEST_DB=1 no .env.test. Nunca use o banco de apps/api/.env.
# DATABASE_URL=postgresql://freelah:freelah@127.0.0.1:54329/freelah_test?sslmode=disable

# --- Etapa 2: autenticação (Better Auth) ---
# Segredo que assina os cookies de sessão: no mínimo 32 caracteres, único de cada pessoa/ambiente.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar o segredo só desconecta quem estava logado. Nunca versione o valor real.
BETTER_AUTH_SECRET=
# Endereço público desta API (muda no deploy; no desenvolvimento é o localhost).
BETTER_AUTH_URL=http://localhost:3333
# Origens autorizadas a enviar cadastro e login: o site (web do Expo) e o esquema do app.
# Em desenvolvimento, o Expo Go (exp://) já é liberado automaticamente.
TRUSTED_ORIGINS=http://localhost:8081,freelah://
# ADMIN_EMAILS=  (etapa 9)

# ============================================================
# APP  ->  apps/mobile/.env
# ============================================================
# Web (navegador no mesmo computador): http://localhost:3333
# Expo Go no celular: use o IP do computador na rede local,
# ex.: http://192.168.0.10:3333 (veja o README).
EXPO_PUBLIC_API_URL=http://localhost:3333
