{
  "name": "@freelah/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "prestart": "prisma generate",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "prisma generate",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:migrate:test": "node --env-file=.env.test ../../node_modules/prisma/build/index.js migrate deploy",
    "db:local": "tsx scripts/local-db.ts",
    "db:reset:local": "tsx --env-file=.env scripts/reset-local.ts",
    "predev:neon": "prisma generate",
    "dev:neon": "tsx scripts/with-env.ts --neon .env.neon -- tsx watch --env-file-if-exists=.env src/server.ts",
    "db:deploy:neon": "tsx scripts/with-env.ts --neon .env.neon -- prisma migrate deploy",
    "db:seed:neon": "tsx scripts/with-env.ts --neon .env.neon -- prisma db seed"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.6",
    "@freelah/shared": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.6",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "17.10.0-beta.17",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
